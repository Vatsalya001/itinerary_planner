# Perfect Saturday Planner configuration. Every setting in backend/app/config.py, plus the provider keys that the
# LangChain integrations read from the environment.
#
#   cp .env.example backend/.env      # the backend reads .env from its working directory (backend/)
#
# `make dev`, `make serve` and `make eval` pass backend/.env to `uv run --env-file`; the app and the eval runner
# also export CEREBRAS_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY, XAI_API_KEY and LANGSMITH_API_KEY.
# docker compose and `make docker-run` read the same file. Variables set in your shell take precedence.
#
# Rules: KEY=value, one per line, no quotes (Docker's env-file parser keeps quotes literally). Leave a secret
# empty or commented out when you don't have it. Optional settings are commented out (unset = None); FIXED_NOW
# must be a valid datetime when present, so never leave it empty. Never commit backend/.env (it is git-ignored).
#
# Works with no keys at all: Ollama (local models), the OSM snapshot (places), Open-Meteo (weather and
# geocoding) and the fixture providers are keyless.

# ---- Runtime ------------------------------------------------------------------------------------------------
# dev | test | prod. prod hides /api/openapi.json, ignores FIXED_NOW and FAULT, and hides LangSmith inputs/outputs.
APP_ENV=dev
# Release identifier for /api/health, logs and Sentry (default "dev"). The Docker image fills it from the build
# arg or Render's RENDER_GIT_COMMIT, so leave it unset there.
# GIT_SHA=dev

# ---- Models ("provider:model" IDs from backend/app/llm/models.yaml) -------------------------------------------
# Local default (keyless, needs `make ollama`). Production: cerebras:gpt-oss-120b with FALLBACK_MODEL
# groq:openai/gpt-oss-120b. No LLM: baseline:deterministic
PRIMARY_MODEL=ollama:qwen3.5:9b
# Optional second model tried when the primary fails (unset = none; the rule-based planner still covers failures)
# FALLBACK_MODEL=
# Optional default judge for `python -m evals.runner --judge-model` (a registry ID). The app itself never reads
# it. When neither this nor --judge-model is set, no judge runs and judge_quality is reported as null.
# JUDGE_MODEL=groq:openai/gpt-oss-120b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Provider keys (secrets). Production uses Cerebras (cloud.cerebras.ai; keys start with csk-) as the primary and
# Groq (console.groq.com; keys start with gsk_) as the fallback. The others are optional, unused providers.
CEREBRAS_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio). Not the Maps key.
GOOGLE_API_KEY=
XAI_API_KEY=

# ---- Data providers ---------------------------------------------------------------------------------------------
# auto = google when GOOGLE_MAPS_API_KEY is set, else osm_snapshot (keyless). Also: google | osm_snapshot | fixture
PLACES_PROVIDER=auto
# auto = tavily when TAVILY_API_KEY is set, else none. Also: tavily | fixture | none
EVENTS_PROVIDER=auto
# open_meteo (keyless, live) | fixture (frozen world)
WEATHER_PROVIDER=open_meteo
# open_meteo (keyless, live) | fixture (frozen world)
GEOCODER=open_meteo
# Secret. Restrict it to Places API (New) in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Secret. Tavily web search for events.
TAVILY_API_KEY=
# Fixture weather provider only: clear | rain_85pct | unavailable
FIXTURE_WEATHER=clear

# ---- Runtime limits -------------------------------------------------------------------------------------------
# Hard deadline per planner run (seconds)
RUN_DEADLINE_S=60
MAX_AGENT_TURNS=10
# Initial submission + repairs
MAX_SUBMIT_ATTEMPTS=3
# Global plans per UTC day
DAILY_PLAN_CAP=200
# Per-IP plan limits
RATE_LIMIT_PER_10MIN=15
RATE_LIMIT_PER_DAY=60
MAX_BODY_BYTES=16384
# true only behind a proxy that appends the client IP to X-Forwarded-For (Render). Locally: false
TRUST_PROXY_HEADERS=false
SHARE_TTL_DAYS=30
# Built UI served at /. Relative to backend/. The Docker image uses /app/frontend/dist
FRONTEND_DIST=../frontend/dist

# ---- Storage and observability --------------------------------------------------------------------------------
# sqlite:///./data/app.db (relative to backend/) | sqlite:////abs/path.db | sqlite:///:memory: |
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require (Neon in production). LangGraph checkpoints go to
# <name>.checkpoints.db next to a SQLite file (app.db -> app.checkpoints.db), or to the same Postgres database.
DATABASE_URL=sqlite:///./data/app.db
# Secret. Sentry error tracking; empty = off
SENTRY_DSN=
# LangSmith tracing; needs LANGSMITH_API_KEY. Project defaults to saturday-planner-<APP_ENV>
TRACING_ENABLED=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=saturday-planner-dev

# ---- Tests and evals only (ignored when APP_ENV=prod) ---------------------------------------------------------
# Freeze the clock, ISO 8601 with offset
# FIXED_NOW=2026-11-05T10:00:00+05:30
# Inject a fault. Providers: places_http_503 | events_search_error | geocoder_down. Scripted fake model only:
# llm_timeout | llm_refusal | primary_provider_503 | submit_plan_unknown_ids_twice | text_only_final_turn |
# parser_omits_diet_and_agent_selects_nonveg. Unknown names are logged as a warning and ignored.
# FAULT=places_http_503
# Opt-in test suites: RUN_LIVE=1 (network/keys, pytest -m live), RUN_OLLAMA=1 (pytest -m ollama)
# RUN_LIVE=1
# RUN_OLLAMA=1

# ---- Docker only ------------------------------------------------------------------------------------------------
# Port uvicorn listens on inside the container (Render injects its own)
# PORT=8000
