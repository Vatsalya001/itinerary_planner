        "url": "https://events.example.com/bengaluru/indie-acoustic-evening-2026-11-07",
        "location": {
          "@type": "Place",
          "name": "Alliance Francaise de Bangalore",
          "address": {"@type": "PostalAddress", "streetAddress": "Thimmaiah Road, Vasanth Nagar", "addressLocality": "Bengaluru"},
          "geo": {"@type": "GeoCoordinates", "latitude": 12.9914, "longitude": 77.5969}
        },
        "offers": {"@type": "Offer", "price": "300", "priceCurrency": "INR"},
